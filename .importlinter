[importlinter]
root_packages =
    mltgnt
include_external_packages = True

[importlinter:contract:layered]
name = mltgnt layered architecture
type = layers
layers =
    daemon | media
    scheduler | agent | routing
    persona | skill | memory | conversation
    bridges
    interfaces
containers =
    mltgnt
ignore_imports =
    mltgnt.* -> mltgnt.config
    mltgnt.bridges.* -> mltgnt.skill.*
    mltgnt.skill.matcher -> mltgnt.routing.agentic_discover
unmatched_ignore_imports_alerting = warn

[importlinter:contract:l3_no_ghdag]
name = L3 domain must not import ghdag directly
type = forbidden
source_modules =
    mltgnt.persona
    mltgnt.skill
    mltgnt.memory
    mltgnt.conversation
forbidden_modules =
    ghdag
allow_indirect_imports = True

[importlinter:contract:core_no_media]
name = Core packages must not import the media layer
type = forbidden
source_modules =
    mltgnt.scheduler
    mltgnt.agent
    mltgnt.routing
    mltgnt.persona
    mltgnt.skill
    mltgnt.memory
    mltgnt.conversation
    mltgnt.bridges
    mltgnt.interfaces
forbidden_modules =
    mltgnt.media

[importlinter:contract:media_slack_webchat]
name = media.slack and media.webchat must not import each other
type = layers
containers =
    mltgnt.media
layers =
    (slack) | (webchat)
